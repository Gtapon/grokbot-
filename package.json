{
  "name": "yachicut-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "YachiCut MVP — AI-operable local video editor (CLI + MCP + Web UI)",
  "bin": {
    "yachicut": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite",
    "dev:server": "tsx watch src/server/api.ts",
    "cli": "tsx src/cli/index.ts",
    "mcp": "tsx src/mcp/server.ts",
    "demo": "tsx scripts/demo.ts",
    "start": "tsx src/server/api.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "commander": "^13.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
