{
  "_yachicut": {
    "description": "PLACEHOLDER workflow template. Replace this entire file with a ComfyUI 'Save (API Format)' export from your own text-to-image (or video) graph. Keep or update the _yachicut hints so YachiCut can inject prompt / size / seed. String placeholders {{PROMPT}}, {{NEGATIVE}}, {{WIDTH}}, {{HEIGHT}}, {{SEED}} are also substituted.",
    "promptNodeId": "6",
    "promptInput": "text",
    "negativeNodeId": "7",
    "negativeInput": "text",
    "widthNodeId": "5",
    "heightNodeId": "5",
    "seedNodeId": "3",
    "seedInput": "seed"
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "{{SEED}}",
      "steps": 20,
      "cfg": 7,
      "sampler_name": "euler",
      "scheduler": "normal",
      "denoise": 1,
      "model": ["4", 0],
      "positive": ["6", 0],
      "negative": ["7", 0],
      "latent_image": ["5", 0]
    },
    "_meta": { "title": "KSampler" }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "v1-5-pruned-emaonly.safetensors"
    },
    "_meta": { "title": "Load Checkpoint — CHANGE ME to a model you have installed" }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": "{{WIDTH}}",
      "height": "{{HEIGHT}}",
      "batch_size": 1
    },
    "_meta": { "title": "Empty Latent Image" }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{PROMPT}}",
      "clip": ["4", 1]
    },
    "_meta": { "title": "CLIP Text Encode (Prompt)" }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "{{NEGATIVE}}",
      "clip": ["4", 1]
    },
    "_meta": { "title": "CLIP Text Encode (Negative)" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["3", 0],
      "vae": ["4", 2]
    },
    "_meta": { "title": "VAE Decode" }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": {
      "filename_prefix": "yachicut",
      "images": ["8", 0]
    },
    "_meta": { "title": "Save Image" }
  }
}
